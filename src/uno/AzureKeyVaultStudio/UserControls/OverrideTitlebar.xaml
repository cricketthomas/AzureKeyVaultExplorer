<UserControl
    x:Class="AzureKeyVaultStudio.UserControls.OverrideTitlebar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals">
    <StackPanel
        x:Name="DefaultTitleBar"
        Height="32"
        Padding="4,0,0,0"
        Orientation="Horizontal">
        <Button
            x:Name="BackButton"
            Width="40"
            Height="29"
            Padding="0"
            VerticalAlignment="Stretch"
            AutomationProperties.Name="Back"
            Background="Transparent"
            BorderThickness="0"
            Click="BackButton_Click"
            Content="&#xE72B;"
            CornerRadius="4"
            FontFamily="Segoe Fluent Icons"
            FontSize="11"
            Visibility="{x:Bind IsBackButtonVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
        <Image
            Width="16"
            Height="16"
            Margin="12,0,0,0"
            Source="/Assets/Images/AppIcon.png" />
        <TextBlock
            Margin="16,0,0,1"
            VerticalAlignment="Center"
            FontSize="12"
            Text="Key Vault Explorer for Azure" />
        <TextBlock
            Margin="4,0,0,1"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind SecondaryTitle, Mode=OneWay}" />
    </StackPanel>
    <!--<TitleBar
        x:Name="DefaultTitleBar"
        Title="Key Vault Explorer for Azure"
        AutoRefreshDragRegions="False"

        BackRequested="DefaultTitleBar_BackRequested"
        IsBackButtonEnabled="True"
