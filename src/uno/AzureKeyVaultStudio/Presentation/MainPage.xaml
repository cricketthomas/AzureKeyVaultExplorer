<Page
    x:Class="AzureKeyVaultStudio.Presentation.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:local="using:AzureKeyVaultStudio.Presentation"
    xmlns:macos="http://uno.ui/macos"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="http://uno.ui/not_win"
    xmlns:triggers="using:CommunityToolkit.WinUI"
    xmlns:uc="using:AzureKeyVaultStudio.UserControls"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    NavigationCacheMode="Required"
    mc:Ignorable="macos skia">

    <!--  Background=""  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <SplitView
            x:Name="MainSplitView"
            Grid.Row="0"
            Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}"
            DisplayMode="{x:Bind ViewModel.SplitViewDisplay, Mode=TwoWay}"
            IsPaneOpen="{x:Bind ViewModel.IsPaneOpen, Mode=TwoWay}"
            OpenPaneLength="{x:Bind ViewModel.SplitViewWidth, Mode=TwoWay}"
            PaneBackground="Transparent"
            PanePlacement="{x:Bind ViewModel.PanePlacement, Mode=OneWay}">


            <SplitView.Pane>
                <Grid Margin="0,0,0,0" Background="{ThemeResource SolidBackgroundFillColorQuarternaryBrush}">
                    <StackPanel
                        x:Name="AboveTreeViewArea"
                        Width="{x:Bind MainSplitView.OpenPaneLength, Mode=OneWay}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Spacing="0">
                        <Image
                            Width="18"
                            Margin="15,14,0,0"
                            HorizontalAlignment="Left"
                            Source="/Assets/Images/AppIcon.png" />
                    </StackPanel>

                    <Grid
                        Margin="0,39,0,0"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource TabViewBorderBrushCustom}"
                        BorderThickness="0,1,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid
                            Grid.Row="1"
                            Margin="4"
                            BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <RelativePanel Grid.Row="0" Width="{x:Bind MainSplitView.OpenPaneLength, Mode=OneWay}">

                                <TextBlock
                                    x:Name="PaneHeader"
                                    x:Uid="PaneHeader"
                                    Margin="5,5,0,0"
                                    FontSize="13"
                                    FontWeight="Medium"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel
                                    Margin="0,0,10,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    RelativePanel.AlignRightWith="PaneHeader"
                                    RelativePanel.AlignRightWithPanel="True">

                                    <Button
                                        x:Uid="PaneLocationToggleButton"
                                        Margin="0"
                                        Command="{x:Bind ViewModel.TogglePaneLocationCommand}"
                                        Content="&#xE8AB;"
                                        FontFamily="Segoe Fluent Icons"
                                        Style="{StaticResource TransparentButton}" />

                                    <ToggleButton
                                        x:Uid="PaneDisplayToggleButton"
                                        Command="{x:Bind ViewModel.ToggleSplitViewDisplayCommand}"
                                        Content="&#xE718;"
                                        FontFamily="Segoe Fluent Icons"
                                        Style="{StaticResource TransparentToggleButton}" />

                                    <Button
                                        x:Uid="PaneToggleButton"
                                        Command="{x:Bind ViewModel.ClosePaneCommand}"
                                        Content="&#xE8BB;"
                                        FontFamily="Segoe Fluent Icons"
                                        Style="{StaticResource TransparentButton}" />
                                </StackPanel>
                            </RelativePanel>

                            <uc:KeyVaultTree
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                DataContext="{x:Bind KeyVaultTreeViewModel, Mode=OneWay}" />

                        </Grid>

                        <Grid Grid.Row="1" Visibility="{x:Bind MainSplitView.IsPaneOpen, Mode=OneWay}">

                            <controls:PropertySizer
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                Binding="{x:Bind ViewModel.InvertedSplitViewWidth, Mode=TwoWay}"
                                Maximum="700"
                                Minimum="100"
                                Visibility="{x:Bind ViewModel.IsPaneLeft, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=True}" />

                            <controls:PropertySizer
                                HorizontalAlignment="Right"
                                Binding="{x:Bind ViewModel.SplitViewWidth, Mode=TwoWay}"
                                Maximum="700"
                                Minimum="100"
                                Visibility="{x:Bind ViewModel.IsPaneLeft, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}" />
                        </Grid>

                    </Grid>
                </Grid>

            </SplitView.Pane>

            <SplitView.Content>
                <local:TabsControl x:Name="VaultTabsControl" />
            </SplitView.Content>


        </SplitView>

        <uc:StatusBarControl Grid.Row="2" />

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="SplitViewPaneIsLeftAndOpen">
                    <VisualState.StateTriggers>
                        <triggers:IsEqualStateTrigger Value="{x:Bind ViewModel.IsPaneLeft, Mode=OneWay}" To="True" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AboveTreeViewArea.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="SplitViewPaneRight">
                    <VisualState.StateTriggers>
                        <triggers:IsEqualStateTrigger Value="{x:Bind ViewModel.IsPaneLeft, Mode=OneWay}" To="False" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AboveTreeViewArea.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>

</Page>
